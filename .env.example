# Replit provides DATABASE_URL and Clerk keys automatically in a configured app.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_stock
SESSION_SECRET=replace-with-a-long-random-secret
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Add the first platform super admin after signing up. Comma-separated values.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_USER_IDS=

# Required to enable verified inbound WhatsApp Business webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v27.0
